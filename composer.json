{
    "name": "sympress/maker-bundle",
    "description": "Package-aware Symfony MakerBundle integration for SymPress website workspaces.",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Brian Schaffner",
            "email": "brian.schaeffner@sympress.io",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.5",
        "composer-runtime-api": "^2.1",
        "symfony/maker-bundle": "^1.68",
        "sympress/kernel": "^1.1.1",
        "symfony/process": "^8.1"
    },
    "require-dev": {
        "symfony/security-core": "^8.1",
        "symfony/validator": "^8.1",
        "sympress/qa": "^0.1.2"
    },
    "autoload": {
        "psr-4": {
            "SymPress\\MakerBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SymPress\\MakerBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "kernel": {
            "bundle": "SymPress\\MakerBundle\\SymPressMakerBundle",
            "entry": "maker-bundle"
        }
    },
    "scripts": {
        "cs": [
            "Composer\\Config::disableProcessTimeout",
            "qa cs"
        ],
        "cs:fix": [
            "Composer\\Config::disableProcessTimeout",
            "qa cs:fix"
        ],
        "static-analysis": [
            "Composer\\Config::disableProcessTimeout",
            "qa static-analysis"
        ],
        "tests": [
            "Composer\\Config::disableProcessTimeout",
            "qa tests"
        ],
        "test": [
            "@tests"
        ],
        "qa": [
            "@cs",
            "@static-analysis",
            "@tests"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
